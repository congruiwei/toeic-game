  "entries": [
    {
      "id": "pre-re",
      "type": "prefix",
      "forms": [
        "re-"
      ],
      "zh": "再次；回到原处",
      "ja": "再び；元に戻して",
      "examples": [
        "v-reroute",
        "v-restock",
        "v-reorder",
        "v-reschedule",
        "v-renewable",
        "v-reusable"
      ],
      "sources": [
        "british-council",
        "athabasca"
      ],
      "kanji": "再",
      "noteZh": "只在已核实的词里使用；并非所有 re 开头的词都表示“再次”。",
      "noteJa": "確認された語だけに使います。re で始まる語がすべて「再び」を表すわけではありません。"
    },
    {
      "id": "pre-pre",
      "type": "prefix",
      "forms": [
        "pre-"
      ],
      "zh": "在……之前；预先",
      "ja": "前に；あらかじめ",
      "examples": [
        "v-precaution",
        "v-prerequisite",
        "v-predecessor"
      ],
      "sources": [
        "mw-precaution",
        "mw-predecessor",
        "british-council"
      ],
      "kanji": "前・予"
    },
    {
      "id": "pre-sub",
      "type": "prefix",
      "forms": [
        "sub-"
      ],
      "zh": "在下面；下一级",
      "ja": "下に；下位の",
      "examples": [
        "v-subtotal",
        "v-subcontractor",
        "v-subscribe",
        "v-subscription"
      ],
      "sources": [
        "mw-subscribe",
        "athabasca"
      ],
      "kanji": "下",
      "noteZh": "词源中的空间关系有时变为组织或概念关系。",
      "noteJa": "語源の位置関係が、組織や概念上の関係を表すこともあります。"
    },
    {
      "id": "pre-inter",
      "type": "prefix",
      "forms": [
        "inter-"
      ],
      "zh": "在……之间；相互",
      "ja": "間の；相互の",
      "examples": [
        "v-international",
        "v-intermission"
      ],
      "sources": [
        "mw-international",
        "mw-intermission",
        "british-council"
      ],
      "kanji": "間"
    },
    {
      "id": "pre-co",
      "type": "prefix",
      "forms": [
        "co-",
        "con-",
        "com-",
        "col-",
        "cor-"
      ],
      "zh": "共同；一起",
      "ja": "共に；一緒に",
      "examples": [
        "v-coworker",
        "v-coordinator",
        "v-construction"
      ],
      "sources": [
        "athabasca",
        "mw-construct"
      ],
      "kanji": "共",
      "noteZh": "同一拉丁前缀有不同拼写；只展示经核实的家族，不按开头猜词源。",
      "noteJa": "同じラテン語由来の接頭辞に複数の形があります。綴りの先頭だけでは判断しません。"
    },
    {
      "id": "pre-ex",
      "type": "prefix",
      "forms": [
        "ex-",
        "e-"
      ],
      "zh": "向外；出去",
      "ja": "外へ；外に",
      "examples": [
        "v-export",
        "v-exporter",
        "v-exclude"
      ],
      "sources": [
        "mw-export",
        "mw-exclude"
      ],
      "kanji": "出・輸出",
      "noteZh": "这里收录“向外”的意义；表示“前任”的 ex- 是另一种用法。",
      "noteJa": "ここでは「外へ」の意味を扱います。「元の」を表す用法とは区別します。"
    },
    {
      "id": "pre-in-into",
      "type": "prefix",
      "forms": [
        "in-",
        "im-"
      ],
      "zh": "向内；进入",
      "ja": "中へ；中に",
      "examples": [
        "v-import",
        "v-importer",
        "v-inspect",
        "v-include"
      ],
      "sources": [
        "mw-import",
        "mw-inspect",
        "mw-include"
      ],
      "kanji": "入・輸入",
      "noteZh": "与表示否定的同形前缀分开记。",
      "noteJa": "否定を表す同じ形の接頭辞とは分けて覚えます。"
    },
    {
      "id": "pre-in-not",
      "type": "prefix",
      "forms": [
        "in-",
        "im-",
        "il-",
        "ir-"
      ],
      "zh": "不；非",
      "ja": "〜でない",
      "examples": [
        "v-ineligible",
        "v-impartial",
        "v-informal",
        "v-insufficient",
        "v-invalid",
        "v-inconclusive"
      ],
      "sources": [
        "mw-impartial",
        "mw-ineligible",
        "british-council"
      ],
      "kanji": "不・非",
      "noteZh": "常见变体：在 p、b、m 前用 im-，l 前用 il-，r 前用 ir-；不是见到字母就能套用。",
      "noteJa": "p・b・m の前では im-、l の前では il-、r の前では ir- がよく使われますが、文字だけで判断はできません。"
    },
    {
      "id": "pre-dis",
      "type": "prefix",
      "forms": [
        "dis-"
      ],
      "zh": "取消；分开；相反",
      "ja": "取り消す；離す；反対の",
      "examples": [
        "v-discontinue",
        "v-disconnect",
        "v-disembark"
      ],
      "sources": [
        "mw-discontinue",
        "mw-disconnect",
        "british-council"
      ]
    },
    {
      "id": "pre-non",
      "type": "prefix",
      "forms": [
        "non-"
      ],
      "zh": "不；非",
      "ja": "〜でない",
      "examples": [
        "v-nonrefundable",
        "v-nonperishable",
        "v-nonstop"
      ],
      "sources": [
        "mw-nonrefundable",
        "british-council"
      ],
      "kanji": "非"
    },
    {
      "id": "pre-over",
      "type": "prefix",
      "forms": [
        "over-"
      ],
      "zh": "过量；超过",
      "ja": "過度に；超えて",
      "examples": [
        "v-overbooking",
        "v-overstock",
        "v-overdue",
        "v-overtime"
      ],
      "sources": [
        "mw-overbook",
        "athabasca"
      ],
      "kanji": "過",
      "noteZh": "本家族突出“超过”的意义，不把 overnight 等其他用法混成同一个意思。",
      "noteJa": "ここでは「超える」意味に注目し、overnight など別の用法とは分けます。"
    },
    {
      "id": "pre-trans",
      "type": "prefix",
      "forms": [
        "trans-"
      ],
      "zh": "跨越；从一处到另一处",
      "ja": "越えて；別の場所へ",
      "examples": [
        "v-transport",
        "v-transportation",
        "v-transfer"
      ],
      "sources": [
        "mw-transport",
        "mw-transfer"
      ],
      "kanji": "移"
    },
    {
      "id": "root-port",
      "type": "root",
      "forms": [
        "port"
      ],
      "zh": "搬运；携带",
      "ja": "運ぶ",
      "examples": [
        "v-transport",
        "v-portable",
        "v-porter",
        "v-export",
        "v-import",
        "v-transportation"
      ],
      "sources": [
        "mw-transport",
        "mw-portable"
      ],
      "noteZh": "来自拉丁语中“搬运”的词干；portion 的词源不同。",
      "noteJa": "ラテン語の「運ぶ」に由来する語幹です。portion は別の語源です。"
    },
    {
      "id": "root-spect",
      "type": "root",
      "forms": [
        "spec",
        "spect"
      ],
      "zh": "看；观察",
      "ja": "見る；観察する",
      "examples": [
        "v-inspect",
        "v-inspection",
        "v-inspector",
        "v-prospective"
      ],
      "sources": [
        "mw-inspect"
      ],
      "noteZh": "现代拼写常见 spect；词义需要结合前缀和完整词义。",
      "noteJa": "現代の綴りでは spect がよく見られ、接頭辞と語全体の意味も合わせて考えます。"
    },
    {
      "id": "root-scrib",
      "type": "root",
      "forms": [
        "scrib",
        "script"
      ],
      "zh": "写",
      "ja": "書く",
      "examples": [
        "v-subscribe",
        "v-subscription"
      ],
      "sources": [
        "mw-subscribe",
        "mw-subscription"
      ],
      "noteZh": "订阅的历史来源与在文件下方签名、作出承诺有关。",
      "noteJa": "定期購読の語源は、書類の末尾に署名して約束することと関係があります。"
    },
    {
      "id": "root-struct",
      "type": "root",
      "forms": [
        "struct"
      ],
      "zh": "建造；安排",
      "ja": "組み立てる；整える",
      "examples": [
        "v-construction",
        "v-instruction"
      ],
      "sources": [
        "mw-construct",
        "mw-instruction"
      ],
      "noteZh": "这是历史词干；instruction 的现代义是指示或指导，不宜逐字译成“造进去”。",
      "noteJa": "歴史的な語幹です。instruction の現在の意味は指示や指導で、直訳では捉えられません。"
    },
    {
      "id": "root-ject",
      "type": "root",
      "forms": [
        "ject"
      ],
      "zh": "投；抛",
      "ja": "投げる",
      "examples": [
        "v-reject",
        "v-projection"
      ],
      "sources": [
        "mw-reject",
        "mw-projection"
      ],
      "noteZh": "词义从“抛”引申而来；预测和拒绝仍要按完整词义记。",
      "noteJa": "「投げる」から意味が広がっていますが、予測や拒否という語全体の意味も覚えます。"
    },
    {
      "id": "root-fer",
      "type": "root",
      "forms": [
        "fer"
      ],
      "zh": "带；携带",
      "ja": "運ぶ；持っていく",
      "examples": [
        "v-transfer",
        "v-refer"
      ],
      "sources": [
        "mw-transfer",
        "mw-refer"
      ]
    },
    {
      "id": "root-mit",
      "type": "root",
      "forms": [
        "mit",
        "miss"
      ],
      "zh": "送；放行",
      "ja": "送る；通す",
      "examples": [
        "v-submit",
        "v-remit",
        "v-permission",
        "v-admission",
        "v-intermission"
      ],
      "sources": [
        "mw-submit",
        "mw-permission"
      ],
      "noteZh": "词干在不同派生词中出现 mit / miss 两种形态；现代意义可能已经引申。",
      "noteJa": "派生語によって mit と miss の形が現れ、現在の意味は広がっている場合があります。"
    },
    {
      "id": "root-clud",
      "type": "root",
      "forms": [
        "clud",
        "clus"
      ],
      "zh": "关闭；围住",
      "ja": "閉じる；囲む",
      "examples": [
        "v-include",
        "v-exclude",
        "v-exclusive",
        "v-conclude",
        "v-conclusion"
      ],
      "sources": [
        "mw-include",
        "mw-exclude"
      ]
    },
    {
      "id": "root-copy",
      "type": "root",
      "forms": [
        "copy"
      ],
      "zh": "复制；副本",
      "ja": "複製；写し",
      "examples": [
        "v-copy",
        "v-copyright"
      ],
      "sources": [
        "mw-copyright"
      ],
      "noteZh": "这里是完整基础词，不是把 copy 再拆成古典词根；copyright 是复合词，指复制作品的权利。",
      "noteJa": "ここでは語全体を基礎語として扱います。copyright は複製する権利を表す複合語です。"
    },
    {
      "id": "root-interview",
      "type": "root",
      "forms": [
        "interview"
      ],
      "zh": "面试；访谈",
      "ja": "面接；インタビュー",
      "examples": [
        "v-interview",
        "v-interviewer",
        "v-interviewee"
      ],
      "sources": [
        "mw-interview",
        "mw-interviewer"
      ],
      "noteZh": "把完整基础词与 -er、-ee 连接：提问者与受访者；它们不是错误易混词。",
      "noteJa": "基礎語に -er、-ee を付け、質問する側と受ける側を区別します。混同しやすい無関係な語ではありません。"
    },
    {
      "id": "suf-ly",
      "type": "suffix",
      "forms": [
        "-ly"
      ],
      "zh": "以……方式",
      "ja": "〜に；〜のように",
      "examples": [
        "v-briefly",
        "v-promptly",
        "v-respectfully",
        "v-strictly"
      ],
      "sources": [
        "cambridge-suffixes"
      ],
      "pos": [
        "adv."
      ],
      "noteZh": "常把形容词变成副词；costly、monthly 等词的 -ly 不属于这一用法。",
      "noteJa": "形容詞から副詞を作ることが多いですが、costly や monthly などには当てはまりません。"
    },
    {
      "id": "suf-ment",
      "type": "suffix",
      "forms": [
        "-ment"
      ],
      "zh": "行为；结果；状态",
      "ja": "行為；結果；状態",
      "examples": [
        "v-payment",
        "v-shipment",
        "v-equipment",
        "v-retirement",
        "v-amendment",
        "v-replacement"
      ],
      "sources": [
        "cambridge-suffixes"
      ],
      "pos": [
        "n."
      ]
    },
    {
      "id": "suf-ion",
      "type": "suffix",
      "forms": [
        "-ion",
        "-tion",
        "-ation",
        "-sion"
      ],
      "zh": "行为；过程；结果",
      "ja": "行為；過程；結果",
      "examples": [
        "v-inspection",
        "v-transportation",
        "v-reservation",
        "v-application",
        "v-expansion",
        "v-conclusion"
      ],
      "sources": [
        "cambridge-suffixes"
      ],
      "pos": [
        "n."
      ],
      "noteZh": "常见名词结尾；切分会保留历史词干末尾的 t 或 s，不能仅凭末尾字母替代语法判断。",
      "noteJa": "よくある名詞の語尾です。歴史的な語幹の t や s を残す場合があり、語尾だけで文法判断はできません。"
    },
    {
      "id": "suf-able",
      "type": "suffix",
      "forms": [
        "-able",
        "-ible"
      ],
