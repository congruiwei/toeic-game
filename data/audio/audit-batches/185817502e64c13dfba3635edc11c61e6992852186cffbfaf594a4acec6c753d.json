  "segments": [
    {
      "start": 0.5000000000000014,
      "end": 2.78,
      "text": "こんにちはウォーキングツアーのガイドです。",
      "avgLogprob": -0.1269155874064094,
      "noSpeechProb": 0.030171789228916168
    },
    {
      "start": 3.2600000000000016,
      "end": 6.7,
      "text": "明日は噴水前ではなくパン屋の外で集合します。",
      "avgLogprob": -0.1269155874064094,
      "noSpeechProb": 0.030171789228916168
    },
    {
      "start": 7.54,
      "end": 12.28,
      "text": "道路整備の作業員が、午前中いっぱい噴水を清掃するためです。",
      "avgLogprob": -0.1269155874064094,
      "noSpeechProb": 0.030171789228916168
    },
    {
      "start": 13.14,
      "end": 15.3,
      "text": "出発時刻は引き続き従事です。",
      "avgLogprob": -0.1269155874064094,
      "noSpeechProb": 0.030171789228916168
    },
    {
      "start": 16.16,
      "end": 20.32,
      "text": "石の道を歩く区間がありますので歩きやすいくつでお越しください。",
      "avgLogprob": -0.1269155874064094,
