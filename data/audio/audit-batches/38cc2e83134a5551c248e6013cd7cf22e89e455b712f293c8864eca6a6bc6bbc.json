      "text": " Please return gallery umbrellas to the green bin inside the East entrance.",
      "avgLogprob": -0.15016858130693436,
      "noSpeechProb": 0.021227408200502396
    },
    {
      "start": 5.82,
      "end": 7.84,
      "text": " A gray bin beside it holds walking sticks.",
