      "noSpeechProb": 0.021227408200502396
    },
    {
      "start": 8.72,
      "end": 14.1,
      "text": " The green bin has a wide opening so you can put a wet umbrella inside without folding it.",
      "avgLogprob": -0.15016858130693436,
