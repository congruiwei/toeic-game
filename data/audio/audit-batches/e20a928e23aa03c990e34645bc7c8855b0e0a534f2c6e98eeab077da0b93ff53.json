  "segments": [
    {
      "start": 0.0,
      "end": 3.12,
      "text": "昨年の夏にコンクリートで補送しました。",
      "avgLogprob": -0.16319109560028325,
      "noSpeechProb": 0.02526034414768219
    },
    {
      "start": 4.04,
      "end": 6.64,
      "text": "みなさんが門の暗証番号を知っています。",
      "avgLogprob": -0.16319109560028325,
      "noSpeechProb": 0.02526034414768219
    },
    {
      "start": 7.62,
      "end": 10.52,
      "text": "工芸品フェアは日用費も開催しますよね。",
      "avgLogprob": -0.16319109560028325,
      "noSpeechProb": 0.02526034414768219
    },
    {
      "start": 11.32,
      "end": 14.86,
      "text": "工芸品の屋台では、手作りの贈り物を売っています。",
      "avgLogprob": -0.16319109560028325,
      "noSpeechProb": 0.02526034414768219
    },
    {
      "start": 15.72,
      "end": 17.68,
      "text": "フェアの最終費は土曜日です。",
      "avgLogprob": -0.16319109560028325,
      "noSpeechProb": 0.02526034414768219
    },
    {
      "start": 18.46,
      "end": 22.22,
      "text": "主催者は、今年新しい会場案内図を印刷しました。",
      "avgLogprob": -0.16319109560028325,
