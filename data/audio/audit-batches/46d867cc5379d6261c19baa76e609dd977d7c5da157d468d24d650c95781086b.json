  "segments": [
    {
      "start": 0.0,
      "end": 2.6,
      "text": "城路から葉に水が注がれています。",
      "avgLogprob": -0.1617754195347305,
      "noSpeechProb": 0.037536006420850754
    },
    {
      "start": 3.38,
      "end": 5.84,
      "text": "城路が植物の上に吊るされています。",
      "avgLogprob": -0.1617754195347305,
      "noSpeechProb": 0.037536006420850754
    },
    {
      "start": 6.78,
      "end": 9.14,
      "text": "両手で植木鉢を持っている人がいます。",
      "avgLogprob": -0.1617754195347305,
      "noSpeechProb": 0.037536006420850754
    },
    {
      "start": 10.12,
      "end": 12.64,
      "text": "植物の近くの地面に城路があります。",
      "avgLogprob": -0.1617754195347305,
      "noSpeechProb": 0.037536006420850754
    },
    {
      "start": 13.6,
      "end": 15.8,
      "text": "断棒ル箱が大車に詰まれています。",
      "avgLogprob": -0.1617754195347305,
      "noSpeechProb": 0.037536006420850754
    },
    {
      "start": 16.82,
      "end": 19.4,
      "text": "空の大車の横に断棒ル箱があります。",
      "avgLogprob": -0.1617754195347305,
      "noSpeechProb": 0.037536006420850754
    },
    {
      "start": 20.34,
      "end": 22.64,
      "text": "大車を横に倒している人がいます。",
