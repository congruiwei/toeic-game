  "segments": [
    {
      "start": 0.0,
      "end": 5.56,
      "text": "新しい入り口の看板は通りから見つけ やすくなっています。しかし",
      "avgLogprob": -0.25439393683336675,
      "noSpeechProb": 0.0280604250729084
    },
    {
      "start": 5.56,
      "end": 11.22,
      "text": "館内では、常開の事務所への矢印が閉まった 扉を指しています。ドア",
      "avgLogprob": -0.25439393683336675,
      "noSpeechProb": 0.0280604250729084
    },
    {
      "start": 11.22,
      "end": 15.82,
      "text": "ノブオーに、書いたメシター後清掃員 が受付カウンターの後ろの階段",
      "avgLogprob": -0.25439393683336675,
      "noSpeechProb": 0.0280604250729084
    },
    {
      "start": 15.82,
      "end": 21.06,
      "text": "を教えてくれました。階段という文字 を加え矢印を右向きにする",
      "avgLogprob": -0.25439393683336675,
      "noSpeechProb": 0.0280604250729084
    },
    {
      "start": 21.06,
      "end": 22.04,
      "text": "ことを提案します。",
      "avgLogprob": -0.25439393683336675,
      "noSpeechProb": 0.0280604250729084
    },
    {
      "start": 22.04,
      "end": 22.24,
      "text": "お疲れ様です",
      "avgLogprob": -0.9171353446112739,
      "noSpeechProb": 0.6513926386833191
    }
