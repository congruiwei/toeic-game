    },
    {
      "start": 6.82,
      "end": 11.58,
      "text": "私が前半を担当できモールさんは後半を引き受けてくれました。",
      "avgLogprob": -0.14666874635787236,
      "noSpeechProb": 0.02705303020775318
    },
    {
      "start": 12.460000000000003,
      "end": 15.06,
      "text": "それでは各時間帯に1人しかいません。",
      "avgLogprob": -0.14666874635787236,
      "noSpeechProb": 0.02705303020775318
    },
    {
      "start": 15.98,
      "end": 20.96,
