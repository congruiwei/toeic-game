  "segments": [
    {
      "start": 0.0,
      "end": 3.68,
      "text": "受取に署名が必要なサービスを使いたいです。",
      "avgLogprob": -0.1812180918123987,
      "noSpeechProb": 0.06400949507951736
    },
    {
      "start": 4.32,
      "end": 7.66,
      "text": "図書館ではまだ本の貴重を受け付けていますよね。",
      "avgLogprob": -0.1812180918123987,
      "noSpeechProb": 0.06400949507951736
    },
    {
      "start": 8.46,
      "end": 10.86,
      "text": "初半本は青い布張の表示です。",
      "avgLogprob": -0.1812180918123987,
      "noSpeechProb": 0.06400949507951736
    },
    {
      "start": 11.7,
      "end": 14.58,
      "text": "越乱室は休止場の広場に面しています。",
      "avgLogprob": -0.1812180918123987,
      "noSpeechProb": 0.06400949507951736
    },
    {
      "start": 15.46,
      "end": 18.8,
      "text": "プログラムでゲストの性がふたとおりにつずられています。",
      "avgLogprob": -0.1812180918123987,
      "noSpeechProb": 0.06400949507951736
    },
    {
      "start": 19.7,
      "end": 22.72,
      "text": "ご本人のウェブサイトでつずりを確認しましょう。",
      "avgLogprob": -0.1812180918123987,
