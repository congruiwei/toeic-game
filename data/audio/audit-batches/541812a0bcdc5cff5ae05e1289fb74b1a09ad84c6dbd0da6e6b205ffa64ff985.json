  "segments": [
    {
      "start": 0.0,
      "end": 3.08,
      "text": "火曜日に機材窓口でを受け取りください。",
      "avgLogprob": -0.12497862882183906,
      "noSpeechProb": 0.03782545402646065
    },
    {
      "start": 3.88,
      "end": 6.88,
      "text": "ミキサーには金属製のボールが付属します。",
      "avgLogprob": -0.12497862882183906,
      "noSpeechProb": 0.03782545402646065
    },
    {
      "start": 7.72,
      "end": 12.0,
      "text": "金曜日の4時までに、ミキサーとボールを一緒にご返却ください。",
      "avgLogprob": -0.12497862882183906,
      "noSpeechProb": 0.03782545402646065
    },
    {
      "start": 12.9,
      "end": 16.0,
      "text": "コンポーする前にボールの水気を拭き取ってください。",
      "avgLogprob": -0.12497862882183906,
      "noSpeechProb": 0.03782545402646065
    },
    {
      "start": 16.98,
      "end": 18.82,
      "text": "今回の貸し出しは無料です。",
      "avgLogprob": -0.12497862882183906,
      "noSpeechProb": 0.03782545402646065
    },
    {
      "start": 19.54,
      "end": 22.86,
      "text": "ミキサーと一緒に返す必要があるものは何ですか?",
      "avgLogprob": -0.12497862882183906,
      "noSpeechProb": 0.03782545402646065
    }
