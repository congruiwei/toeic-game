  "segments": [
    {
      "start": 0.36000000000000054,
      "end": 5.28,
      "text": "唯一空いている机には、私よりしゃれ機の長い端上が付いています。",
      "avgLogprob": -0.1997943016571727,
      "noSpeechProb": 0.030903244391083717
    },
    {
      "start": 6.22,
      "end": 10.14,
      "text": "職場で最も貴重なものは、軽視的しむ音がしない椅子です。",
      "avgLogprob": -0.1997943016571727,
      "noSpeechProb": 0.030903244391083717
    },
    {
      "start": 11.0,
      "end": 16.8,
      "text": "チームは締め切りに間に合いましたが、誰も中食を食べることを思い出しませんでした。",
      "avgLogprob": -0.1997943016571727,
      "noSpeechProb": 0.030903244391083717
    },
    {
      "start": 17.72,
      "end": 22.36,
      "text": "彼女は、うっかり車内の中食メニューを通しか全員に送ってしまいました。",
      "avgLogprob": -0.1997943016571727,
      "noSpeechProb": 0.030903244391083717
