    {
      "start": 5.3,
      "end": 7.84,
      "text": "待ち合い区覚悟とに別の図表があります。",
      "avgLogprob": -0.1597532148162524,
      "noSpeechProb": 0.016736973077058792
    },
    {
      "start": 8.84,
      "end": 12.84,
      "text": "免除によって2人目の署名は不要になったのではありませんか。",
