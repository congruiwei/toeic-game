  "segments": [
    {
      "start": 0.0,
      "end": 5.98,
      "text": "椅子はすべて彼女が手配しました。すぐ返事をもらえるように電話しましょう。",
      "avgLogprob": -0.1718564963589112,
      "noSpeechProb": 0.0701293870806694
    },
    {
      "start": 6.8,
      "end": 9.02,
      "text": "普段小包は書き止めで送ります。",
      "avgLogprob": -0.1718564963589112,
      "noSpeechProb": 0.0701293870806694
    },
    {
      "start": 9.98,
      "end": 12.76,
      "text": "経費生産の用紙はどこで入手できますか?",
      "avgLogprob": -0.1718564963589112,
      "noSpeechProb": 0.0701293870806694
    },
    {
      "start": 13.58,
      "end": 16.42,
      "text": "経費の生産には約受定業を控かります。",
      "avgLogprob": -0.1718564963589112,
      "noSpeechProb": 0.0701293870806694
    },
    {
      "start": 17.42,
      "end": 19.44,
      "text": "両費の合計は80ドルでした。",
      "avgLogprob": -0.1718564963589112,
      "noSpeechProb": 0.0701293870806694
    },
    {
      "start": 20.34,
      "end": 22.38,
      "text": "シャインハンドブックにリンクがあります。",
      "avgLogprob": -0.1718564963589112,
