  "segments": [
    {
      "start": 0.0,
      "end": 3.06,
      "text": "特典をすべて一度に使う必要がある。",
      "avgLogprob": -0.09823362715542316,
      "noSpeechProb": 0.03701105713844299
    },
    {
      "start": 3.8,
      "end": 6.02,
      "text": "2つ目のアカウントが必要である。",
      "avgLogprob": -0.09823362715542316,
      "noSpeechProb": 0.03701105713844299
    },
    {
      "start": 6.84,
      "end": 9.68,
      "text": "ゲスト公演者からスライドが届きましたが、",
      "avgLogprob": -0.09823362715542316,
      "noSpeechProb": 0.03701105713844299
    },
    {
      "start": 10.04,
      "end": 13.04,
      "text": "公演前には共有しないでほしいとのことです。",
      "avgLogprob": -0.09823362715542316,
      "noSpeechProb": 0.03701105713844299
    },
    {
      "start": 13.9,
      "end": 18.74,
      "text": "字幕担当者は専門用語を確認するため事前に必要としています。",
      "avgLogprob": -0.09823362715542316,
      "noSpeechProb": 0.03701105713844299
    },
    {
      "start": 19.66,
      "end": 22.5,
      "text": "発音付きの名称リストを別に用意できます。",
      "avgLogprob": -0.09823362715542316,
