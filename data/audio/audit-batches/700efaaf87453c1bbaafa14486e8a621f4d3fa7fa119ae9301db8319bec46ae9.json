  "segments": [
    {
      "start": 0.0,
      "end": 4.1,
      "text": "お部屋の鍵を見せていただければ ヘルメットを渡します。",
      "avgLogprob": -0.14863766672957035,
      "noSpeechProb": 0.04337610676884651
    },
    {
      "start": 4.72,
      "end": 8.72,
      "text": "小寺です。自転車はどこに帰せばよい ですか。",
      "avgLogprob": -0.14863766672957035,
      "noSpeechProb": 0.04337610676884651
    },
    {
      "start": 9.6,
      "end": 12.48,
      "text": "暗くなる前にホテル裏の門絵を持ち ください。",
      "avgLogprob": -0.14863766672957035,
      "noSpeechProb": 0.04337610676884651
    },
    {
      "start": 13.4,
      "end": 15.5,
      "text": "来放車は何を希望していますか。",
      "avgLogprob": -0.14863766672957035,
      "noSpeechProb": 0.04337610676884651
    },
    {
      "start": 16.4,
      "end": 17.84,
      "text": "部屋の鍵を修理する。",
      "avgLogprob": -0.14863766672957035,
      "noSpeechProb": 0.04337610676884651
    },
    {
      "start": 18.72,
      "end": 20.36,
      "text": "公園の地図を購入する。",
      "avgLogprob": -0.14863766672957035,
      "noSpeechProb": 0.04337610676884651
    },
    {
      "start": 21.22,
      "end": 22.82,
      "text": "ホテルの部屋を予約する。",
      "avgLogprob": -0.14863766672957035,
      "noSpeechProb": 0.04337610676884651
    }
