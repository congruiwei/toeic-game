  "segments": [
    {
      "start": 0.0,
      "end": 5.66,
      "text": "管理担当のマスターキーの守りは、 経理の領収書管理よりも厳重だ。",
      "avgLogprob": -0.17815522330778616,
      "noSpeechProb": 0.026606746017932892
    },
    {
      "start": 6.44,
      "end": 10.68,
      "text": "はちみつと妙に景気の良いスケッチで 中庭の増援に挑んだ。",
      "avgLogprob": -0.17815522330778616,
      "noSpeechProb": 0.026606746017932892
    },
    {
      "start": 11.52,
      "end": 16.4,
      "text": "書類削減の報告書をもう一冊のせる前に 棚を補強してください。",
      "avgLogprob": -0.17815522330778616,
      "noSpeechProb": 0.026606746017932892
    },
    {
      "start": 17.34,
      "end": 22.26,
      "text": "天次第から組立て説明書を取り出すために 一旦天次第を分解した。",
      "avgLogprob": -0.17815522330778616,
      "noSpeechProb": 0.026606746017932892
    }
