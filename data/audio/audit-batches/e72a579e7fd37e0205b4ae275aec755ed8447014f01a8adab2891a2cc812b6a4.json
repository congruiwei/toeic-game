  "segments": [
    {
      "start": 0.0,
      "end": 2.9,
      "text": " During wet weather we place a long mat at each entrance.",
      "avgLogprob": -0.19736641995152648,
      "noSpeechProb": 0.005806544329971075
    },
    {
      "start": 3.700000000000001,
      "end": 6.74,
      "text": " Before closing time, please lift each mat from the floor.",
      "avgLogprob": -0.19736641995152648,
      "noSpeechProb": 0.005806544329971075
    },
    {
      "start": 7.62,
      "end": 10.44,
      "text": " Hang it on the rail in the washroom so both sides can dry.",
      "avgLogprob": -0.19736641995152648,
      "noSpeechProb": 0.005806544329971075
    },
    {
      "start": 11.48,
      "end": 13.58,
      "text": " The mats by the cafe are heavier than the others.",
      "avgLogprob": -0.19736641995152648,
      "noSpeechProb": 0.005806544329971075
    },
    {
      "start": 14.68,
      "end": 16.02,
      "text": " Two people should lift each one.",
