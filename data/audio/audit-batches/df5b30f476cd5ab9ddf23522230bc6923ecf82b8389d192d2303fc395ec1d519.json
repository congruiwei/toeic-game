  "segments": [
    {
      "start": 0.0,
      "end": 5.02,
      "text": "最初の和者の依頼を決定済みとして扱うとはどういう意味ですか",
      "avgLogprob": -0.17587871699370156,
      "noSpeechProb": 0.015587675385177135
    },
    {
      "start": 5.66,
      "end": 10.72,
      "text": "実際には与えられていない承認があったことをコードが示してしまう",
      "avgLogprob": -0.17587871699370156,
      "noSpeechProb": 0.015587675385177135
    },
    {
      "start": 10.72,
      "end": 14.58,
      "text": "運転手がそのコードで決定に意義を申し立てられる",
      "avgLogprob": -0.17587871699370156,
      "noSpeechProb": 0.015587675385177135
    },
    {
      "start": 15.14,
      "end": 19.06,
      "text": "拠点が承認済みの検査を再度行う必要がある",
      "avgLogprob": -0.17587871699370156,
      "noSpeechProb": 0.015587675385177135
    },
    {
      "start": 19.68,
      "end": 22.52,
      "text": "検査依頼が自動的に起源きれになる",
      "avgLogprob": -0.17587871699370156,
