  "segments": [
    {
      "start": 0.0,
      "end": 1.62,
      "text": " Could you hold the door for me?",
      "avgLogprob": -0.0774537826126272,
      "noSpeechProb": 0.07327448576688766
    },
    {
      "start": 2.3,
      "end": 3.66,
      "text": " The handle is made of brass.",
      "avgLogprob": -0.0774537826126272,
      "noSpeechProb": 0.07327448576688766
    },
    {
      "start": 4.64,
      "end": 5.66,
      "text": " My hands are full too.",
      "avgLogprob": -0.0774537826126272,
      "noSpeechProb": 0.07327448576688766
    },
    {
      "start": 6.58,
      "end": 7.74,
      "text": " I know who painted the door.",
      "avgLogprob": -0.0774537826126272,
      "noSpeechProb": 0.07327448576688766
    },
    {
      "start": 8.76,
      "end": 10.14,
      "text": " The waiting room is getting cold.",
      "avgLogprob": -0.0774537826126272,
      "noSpeechProb": 0.07327448576688766
    },
    {
      "start": 11.06,
      "end": 11.76,
      "text": " It is cold.",
      "avgLogprob": -0.0774537826126272,
      "noSpeechProb": 0.07327448576688766
    },
    {
      "start": 12.7,
      "end": 13.5,
      "text": " I'll shut the window.",
      "avgLogprob": -0.0774537826126272,
      "noSpeechProb": 0.07327448576688766
    },
    {
      "start": 14.46,
      "end": 15.62,
      "text": " The room has six chairs.",
      "avgLogprob": -0.0774537826126272,
      "noSpeechProb": 0.07327448576688766
    },
    {
      "start": 16.58,
      "end": 18.26,
      "text": " My parcel is due this afternoon.",
      "avgLogprob": -0.0774537826126272,
      "noSpeechProb": 0.07327448576688766
    },
    {
      "start": 19.02,
      "end": 20.88,
      "text": " Do you want the red cup or the yellow one?",
      "avgLogprob": -0.0774537826126272,
      "noSpeechProb": 0.07327448576688766
    },
    {
      "start": 21.64,
      "end": 22.94,
