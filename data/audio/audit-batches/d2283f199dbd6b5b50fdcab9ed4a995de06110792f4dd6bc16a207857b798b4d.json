  "segments": [
    {
      "start": 0.0,
      "end": 4.18,
      "text": "ジューズ小さなビヒンタナの鍵は誰が持っていますか。",
      "avgLogprob": -0.21524008315637572,
      "noSpeechProb": 0.09272686392068863
    },
    {
      "start": 4.56,
      "end": 6.48,
      "text": "オーナーは私が持っています。",
      "avgLogprob": -0.21524008315637572,
      "noSpeechProb": 0.09272686392068863
    },
    {
      "start": 7.32,
      "end": 10.1,
      "text": "今下の海の自動販売機のそばにいます。",
      "avgLogprob": -0.21524008315637572,
      "noSpeechProb": 0.09272686392068863
    },
    {
      "start": 11.02,
      "end": 12.1,
      "text": "小次第行きますか。",
      "avgLogprob": -0.21524008315637572,
      "noSpeechProb": 0.09272686392068863
    },
    {
      "start": 12.96,
      "end": 16.16,
      "text": "ジューズ家受付で運転手が私を待っています。",
      "avgLogprob": -0.21524008315637572,
      "noSpeechProb": 0.09272686392068863
    },
    {
      "start": 17.1,
      "end": 18.66,
      "text": "オーナーそっこにいてください。",
      "avgLogprob": -0.21524008315637572,
      "noSpeechProb": 0.09272686392068863
    },
    {
      "start": 19.66,
      "end": 20.7,
      "text": "今持ってあがります。",
      "avgLogprob": -0.21524008315637572,
