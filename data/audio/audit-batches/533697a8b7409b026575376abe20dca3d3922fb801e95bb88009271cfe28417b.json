  "segments": [
    {
      "start": 0.0,
      "end": 4.72,
      "text": "切手には鳥の絵があります。今この切手が出てきました。",
      "avgLogprob": -0.12039086296538676,
      "noSpeechProb": 0.07361301779747009
    },
    {
      "start": 5.72,
      "end": 8.0,
      "text": "ナフダは何枚印刷すればよいですか。",
      "avgLogprob": -0.12039086296538676,
      "noSpeechProb": 0.07361301779747009
    },
    {
      "start": 8.84,
      "end": 13.08,
      "text": "ナフダは白です。8名のお客様に1枚ずつです。",
      "avgLogprob": -0.12039086296538676,
      "noSpeechProb": 0.07361301779747009
    },
    {
      "start": 14.0,
      "end": 16.08,
      "text": "来客名簿はアルファベット順です。",
      "avgLogprob": -0.12039086296538676,
      "noSpeechProb": 0.07361301779747009
    },
    {
      "start": 16.96,
      "end": 18.9,
      "text": "この鍵の番号を読めますか。",
      "avgLogprob": -0.12039086296538676,
      "noSpeechProb": 0.07361301779747009
    },
    {
      "start": 19.76,
      "end": 22.52,
      "text": "メガネがないと番号が小さすぎて読めません。",
      "avgLogprob": -0.12039086296538676,
      "noSpeechProb": 0.07361301779747009
    }
