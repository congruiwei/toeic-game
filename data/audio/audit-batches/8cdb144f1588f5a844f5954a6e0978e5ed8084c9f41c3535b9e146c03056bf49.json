  "segments": [
    {
      "start": 0.0,
      "end": 3.64,
      "text": " On the shelf by the window. When will the cafeteria open?",
      "avgLogprob": -0.14458857058751873,
      "noSpeechProb": 0.08295250684022903
    },
    {
      "start": 4.56,
      "end": 7.74,
