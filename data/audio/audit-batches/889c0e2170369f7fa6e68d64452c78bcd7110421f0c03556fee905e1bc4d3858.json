  "segments": [
    {
      "start": 0.0,
      "end": 3.78,
      "text": "ギャラリー向けの写真募集は金曜日に締め切ります。",
      "avgLogprob": -0.1317530624137437,
      "noSpeechProb": 0.03522416204214096
    },
    {
      "start": 4.44,
      "end": 6.92,
      "text": "元の写真はまだ保管されています。",
      "avgLogprob": -0.1317530624137437,
      "noSpeechProb": 0.03522416204214096
    },
    {
      "start": 7.82,
      "end": 10.9,
      "text": "中線の当選者はいつ発表すればよいですか。",
      "avgLogprob": -0.1317530624137437,
      "noSpeechProb": 0.03522416204214096
    },
    {
      "start": 11.74,
      "end": 14.6,
      "text": "中線圏は当店の視点で印刷しました。",
      "avgLogprob": -0.1317530624137437,
      "noSpeechProb": 0.03522416204214096
    },
    {
      "start": 15.58,
      "end": 18.96,
      "text": "最後のお客様が中線圏を入れるまで待ってください。",
      "avgLogprob": -0.1317530624137437,
      "noSpeechProb": 0.03522416204214096
    },
    {
      "start": 19.88,
      "end": 22.78,
      "text": "当選者には木製の額縁が送られます。",
      "avgLogprob": -0.1317530624137437,
