  "segments": [
    {
      "start": 0.0,
      "end": 4.46,
      "text": "日付が表示されるのは配送書でプレートをスキャンしてからです。",
      "avgLogprob": -0.12383059760341879,
      "noSpeechProb": 0.0319293774664402
    },
    {
      "start": 5.080000000000001,
      "end": 9.62,
      "text": "各リユースケースには固定の番号が付いた金属プレートがあります。",
      "avgLogprob": -0.12383059760341879,
      "noSpeechProb": 0.0319293774664402
    },
    {
      "start": 10.58,
      "end": 13.86,
      "text": "一方紙の配送ラベルは輸送の度に変わります。",
      "avgLogprob": -0.12383059760341879,
      "noSpeechProb": 0.0319293774664402
    },
    {
      "start": 14.68,
      "end": 21.68,
      "text": "日付ランが空白でも状況は未確定であり、ケースがまだお客様の手元にある証拠とはなりません。",
      "avgLogprob": -0.12383059760341879,
