  "segments": [
    {
      "start": 0.0,
      "end": 3.62,
      "text": "スーツケースを引いて階段を登っている人がいます。",
      "avgLogprob": -0.073558286733685,
      "noSpeechProb": 0.039611075073480606
    },
    {
      "start": 4.200000000000001,
      "end": 6.84,
      "text": "スーツケースが机の上で開いています。",
      "avgLogprob": -0.073558286733685,
      "noSpeechProb": 0.039611075073480606
    },
    {
      "start": 7.7,
      "end": 10.42,
      "text": "二人が間にケースを挟んで運んでいます。",
      "avgLogprob": -0.073558286733685,
      "noSpeechProb": 0.039611075073480606
    },
    {
      "start": 11.26,
      "end": 14.22,
      "text": "スーツケースの横で膝を付いている人がいます。",
      "avgLogprob": -0.073558286733685,
      "noSpeechProb": 0.039611075073480606
    },
    {
      "start": 15.12,
      "end": 17.24,
      "text": "カップに手を伸ばしている人がいます。",
      "avgLogprob": -0.073558286733685,
      "noSpeechProb": 0.039611075073480606
    },
    {
      "start": 18.02,
      "end": 19.76,
      "text": "カップが床に置かれています。",
      "avgLogprob": -0.073558286733685,
      "noSpeechProb": 0.039611075073480606
    },
    {
      "start": 20.72,
      "end": 23.0,
      "text": "流しでカップを洗っている人がいます。",
