  "segments": [
    {
      "start": 0.0,
      "end": 3.98,
      "text": "海底版のパンフレットはもう送ったのではありませんか。",
      "avgLogprob": -0.16079843528568744,
      "noSpeechProb": 0.010015655308961868
    },
    {
      "start": 4.64,
      "end": 6.76,
      "text": "消さ送ったのは下書きだけです。",
      "avgLogprob": -0.16079843528568744,
      "noSpeechProb": 0.010015655308961868
    },
    {
      "start": 7.54,
      "end": 10.76,
      "text": "海底版のパンフレットも綺麗に三つ折りにできます。",
      "avgLogprob": -0.16079843528568744,
      "noSpeechProb": 0.010015655308961868
    },
    {
      "start": 11.8,
      "end": 14.86,
      "text": "デザイナーは他のスタッフ寄り先に到着しました。",
      "avgLogprob": -0.16079843528568744,
      "noSpeechProb": 0.010015655308961868
    },
    {
      "start": 15.84,
      "end": 18.56,
      "text": "経理はいつになれば手付き金を支払えますか?",
      "avgLogprob": -0.16079843528568744,
      "noSpeechProb": 0.010015655308961868
    },
    {
      "start": 19.44,
      "end": 21.86,
      "text": "それは当社最大の取引先です。",
