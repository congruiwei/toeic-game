  "segments": [
    {
      "start": 0.0,
      "end": 5.14,
      "text": "プーシールは先に来ることプーシールは続けたり前に進んだりすることです。",
      "avgLogprob": -0.1730794662976787,
      "noSpeechProb": 0.021476268768310547
    },
    {
      "start": 5.76,
      "end": 11.68,
      "text": "ウェイズは持ち上げる対象を目的後に取りわえずは、守護自体が上がることを表します。",
      "avgLogprob": -0.1730794662976787,
      "noSpeechProb": 0.021476268768310547
    },
    {
      "start": 12.56,
      "end": 16.38,
      "text": "例は物を置くことで目的後を取り来は横になることです。",
      "avgLogprob": -0.1730794662976787,
      "noSpeechProb": 0.021476268768310547
    },
    {
      "start": 17.2,
      "end": 22.58,
      "text": "プスペクティブは観点プスペクティブは将来そうなる見込みの物を表す形容詞です。",
