  "segments": [
    {
      "start": 0.0,
      "end": 3.1,
      "text": " The new entrance sign is easy to spot from the street.",
      "avgLogprob": -0.09898051910284089,
      "noSpeechProb": 0.024393275380134583
    },
    {
      "start": 3.8400000000000003,
      "end": 8.2,
      "text": " Inside, however, the arrow for the upstairs office points toward a closed door.",
      "avgLogprob": -0.09898051910284089,
      "noSpeechProb": 0.024393275380134583
    },
    {
      "start": 8.96,
      "end": 14.0,
      "text": " I tried the handle twice before a cleaner showed me the stairs behind the reception counter.",
      "avgLogprob": -0.09898051910284089,
      "noSpeechProb": 0.024393275380134583
    },
    {
      "start": 14.86,
      "end": 18.26,
      "text": " I suggest adding the word stairs and turning the arrow to the right.",
      "avgLogprob": -0.09898051910284089,
      "noSpeechProb": 0.024393275380134583
    },
    {
      "start": 19.2,
      "end": 22.46,
      "text": " New visitors could then follow the sign without asking for help.",
