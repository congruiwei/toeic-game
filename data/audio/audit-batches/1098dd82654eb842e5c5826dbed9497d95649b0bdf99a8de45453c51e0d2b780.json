      "end": 6.46,
      "text": "タオルをたたんで箱に入れている人がいます。",
      "avgLogprob": -0.13421016527434526,
      "noSpeechProb": 0.02813851274549961
    },
    {
      "start": 7.38,
      "end": 9.98,
      "text": "2枚のタオルが横棒にかけられています。",
      "avgLogprob": -0.13421016527434526,
      "noSpeechProb": 0.02813851274549961
    },
    {
      "start": 10.8,
      "end": 13.14,
      "text": "タオルがまかれて棚に置かれています。",
