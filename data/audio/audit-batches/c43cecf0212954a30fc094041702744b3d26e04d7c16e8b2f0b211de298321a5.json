    {
      "start": 6.52,
      "end": 10.86,
      "text": "最初の業者は最安値だったのになぜ評価が低かったのですか。",
      "avgLogprob": -0.17951496549554774,
      "noSpeechProb": 0.03221598267555237
    },
    {
      "start": 11.78,
      "end": 14.54,
      "text": "三つ森に設置費が含まれていなかったからです。",
      "avgLogprob": -0.17951496549554774,
      "noSpeechProb": 0.03221598267555237
    },
    {
      "start": 15.44,
      "end": 18.38,
      "text": "最初のページには業者の住所が乗っています。",
      "avgLogprob": -0.17951496549554774,
      "noSpeechProb": 0.03221598267555237
    },
    {
      "start": 19.26,
      "end": 21.54,
      "text": "三つ森は6月末まで有効です。",
