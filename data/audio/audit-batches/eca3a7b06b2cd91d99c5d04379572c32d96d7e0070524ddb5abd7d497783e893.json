  "segments": [
    {
      "start": 0.0,
      "end": 5.68,
      "text": "次の教室が終わるのを待ちます。 こちらが会画教室のロッカーです。",
      "avgLogprob": -0.11185265755653381,
      "noSpeechProb": 0.033773403614759445
    },
    {
      "start": 6.5,
      "end": 11.46,
      "text": "最初の課題では、筆を使うのでカードで筆のロッカーを探してください。",
      "avgLogprob": -0.11185265755653381,
      "noSpeechProb": 0.033773403614759445
    },
    {
      "start": 12.42,
      "end": 15.88,
      "text": "一人一本ずつ筆を取り長いテーブルへ進んでください。",
      "avgLogprob": -0.11185265755653381,
      "noSpeechProb": 0.033773403614759445
    },
    {
      "start": 16.8,
      "end": 20.72,
      "text": "手袋は2つ目の課題までロッカーに入れたままにしてください。",
      "avgLogprob": -0.11185265755653381,
      "noSpeechProb": 0.033773403614759445
    },
    {
      "start": 21.68,
      "end": 22.66,
      "text": "道具のロッカー",
      "avgLogprob": -0.11185265755653381,
      "noSpeechProb": 0.033773403614759445
    }
