  "segments": [
    {
      "start": 0.0,
      "end": 3.52,
      "text": "こんばんは練習室が二部屋とも開いていますか。",
      "avgLogprob": -0.12885121096912613,
      "noSpeechProb": 0.04484943673014641
    },
    {
      "start": 4.3,
      "end": 6.72,
      "text": "人部屋は合唱団が予約しています。",
      "avgLogprob": -0.12885121096912613,
      "noSpeechProb": 0.04484943673014641
    },
    {
      "start": 7.66,
      "end": 9.86,
      "text": "合唱団は普段屋外で歌います。",
      "avgLogprob": -0.12885121096912613,
      "noSpeechProb": 0.04484943673014641
    },
    {
      "start": 10.84,
      "end": 12.54,
      "text": "どちらの部屋も木の床です。",
      "avgLogprob": -0.12885121096912613,
      "noSpeechProb": 0.04484943673014641
    },
    {
      "start": 13.36,
      "end": 16.38,
      "text": "パン屋は電話番号を変えたのではありませんか。",
      "avgLogprob": -0.12885121096912613,
      "noSpeechProb": 0.04484943673014641
    },
    {
      "start": 17.22,
      "end": 20.6,
      "text": "そのパン屋では、単上日用のろうそくを売っています。",
      "avgLogprob": -0.12885121096912613,
      "noSpeechProb": 0.04484943673014641
    }
