  "segments": [
    {
      "start": 0.0,
      "end": 4.96,
      "text": "応募者は同席していた創業者よりも会社の歴史に詳しかった。",
      "avgLogprob": -0.1717307101672804,
      "noSpeechProb": 0.030196286737918854
    },
    {
      "start": 5.82,
      "end": 11.36,
      "text": "ペーパーレスの職場に応募したら署名入りの神の申込書が3部必要だった。",
      "avgLogprob": -0.1717307101672804,
      "noSpeechProb": 0.030196286737918854
    },
    {
      "start": 12.02,
      "end": 17.38,
      "text": "応募の袖上に細部まで木を配りますと、かき当て先の会社名を間違えた。",
      "avgLogprob": -0.1717307101672804,
      "noSpeechProb": 0.030196286737918854
    },
    {
      "start": 18.28,
      "end": 23.14,
      "text": "職務内容には箱を持ち上げるとあるチームの式まで上げるとは聞いていない。",
      "avgLogprob": -0.1717307101672804,
      "noSpeechProb": 0.030196286737918854
    }
  ]
