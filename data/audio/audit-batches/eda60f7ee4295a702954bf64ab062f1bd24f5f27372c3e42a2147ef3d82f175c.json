  "segments": [
    {
      "start": 0.0,
      "end": 4.58,
      "text": "代謝は階段とエレベーターの間の狭い隙間に置いてあります。",
      "avgLogprob": -0.11652510207358414,
      "noSpeechProb": 0.02985380031168461
    },
    {
      "start": 5.44,
      "end": 11.32,
      "text": "その場所の掲示には長い距離を運ぶ際は代謝をご利用いただけますと書かれています。",
      "avgLogprob": -0.11652510207358414,
      "noSpeechProb": 0.02985380031168461
    },
    {
      "start": 12.18,
      "end": 16.26,
      "text": "マットを洗い場までずっと手で運ばず代謝を使ってください。",
      "avgLogprob": -0.11652510207358414,
      "noSpeechProb": 0.02985380031168461
    },
    {
      "start": 17.2,
      "end": 19.6,
      "text": "カフェは来週修理のため休業します。",
      "avgLogprob": -0.11652510207358414,
