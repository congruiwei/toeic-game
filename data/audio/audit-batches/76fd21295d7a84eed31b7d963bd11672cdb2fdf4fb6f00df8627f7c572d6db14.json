  "segments": [
    {
      "start": 0.0,
      "end": 2.66,
      "text": "午後の公園は約1時間です。",
      "avgLogprob": -0.15194295930862428,
      "noSpeechProb": 0.04073527455329895
    },
    {
      "start": 3.32,
      "end": 7.54,
      "text": "重担が排達前から汚れていたことをどう証明できますか?",
      "avgLogprob": -0.15194295930862428,
      "noSpeechProb": 0.04073527455329895
    },
    {
      "start": 8.38,
      "end": 12.28,
      "text": "積み込み担当者が出荷時に全ての重担を撮影しています。",
      "avgLogprob": -0.15194295930862428,
      "noSpeechProb": 0.04073527455329895
    },
    {
      "start": 13.22,
      "end": 15.84,
      "text": "重担は地元の配送者で届きました。",
      "avgLogprob": -0.15194295930862428,
      "noSpeechProb": 0.04073527455329895
    },
    {
      "start": 16.78,
      "end": 19.26,
      "text": "ラベルの写真にはデザインが写っています。",
      "avgLogprob": -0.15194295930862428,
      "noSpeechProb": 0.04073527455329895
    },
    {
      "start": 20.24,
      "end": 22.78,
      "text": "昨年の同意詳細利用できますよね。",
      "avgLogprob": -0.15194295930862428,
