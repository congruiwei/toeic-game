  "segments": [
    {
      "start": 0.0,
      "end": 2.66,
      "text": "結果に蓋の重量が残っていた。",
      "avgLogprob": -0.10670040815304487,
      "noSpeechProb": 0.01492839865386486
    },
    {
      "start": 3.66,
      "end": 7.56,
      "text": "全て中身の重さというわけでは、ないとはどういう意味ですか。",
      "avgLogprob": -0.10670040815304487,
      "noSpeechProb": 0.01492839865386486
    },
    {
      "start": 8.48,
      "end": 11.28,
      "text": "瓶の中には複数の原量が入っている。",
      "avgLogprob": -0.10670040815304487,
      "noSpeechProb": 0.01492839865386486
    },
    {
      "start": 12.18,
      "end": 14.22,
      "text": "重点器が一部の瓶を飛ばした。",
      "avgLogprob": -0.10670040815304487,
      "noSpeechProb": 0.01492839865386486
    },
    {
      "start": 15.16,
      "end": 18.72,
      "text": "調価して見える重量の一部は容器によるものである。",
      "avgLogprob": -0.10670040815304487,
      "noSpeechProb": 0.01492839865386486
    },
    {
      "start": 19.54,
      "end": 21.9,
      "text": "測る前に中身の一部を取り出した。",
      "avgLogprob": -0.10670040815304487,
      "noSpeechProb": 0.01492839865386486
    }
  ]
