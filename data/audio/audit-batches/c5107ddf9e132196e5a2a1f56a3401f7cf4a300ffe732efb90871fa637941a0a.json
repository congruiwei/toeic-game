  "segments": [
    {
      "start": 0.0,
      "end": 6.38,
      "text": "配送船住所が変更されても水漏り は引き続き有効です。荷物は空",
      "avgLogprob": -0.271640923500061,
      "noSpeechProb": 0.031459495425224304
    },
    {
      "start": 6.38,
      "end": 12.12,
      "text": "ゆではなく鉄道で運ばれ送料が 半額になりました。事務所側の発送",
      "avgLogprob": -0.271640923500061,
      "noSpeechProb": 0.031459495425224304
    },
    {
      "start": 12.12,
      "end": 18.48,
      "text": "窓口で遅れが生じたため料金が 免除されました。職員が正面玄関を",
      "avgLogprob": -0.271640923500061,
      "noSpeechProb": 0.031459495425224304
    },
    {
      "start": 18.48,
      "end": 22.34,
      "text": "占めている間にさらに憎みの団体 が受付に到着しました。",
      "avgLogprob": -0.271640923500061,
      "noSpeechProb": 0.031459495425224304
    }
  ]
