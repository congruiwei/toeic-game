      "noSpeechProb": 0.03501708060503006
    },
    {
      "start": 9.4,
      "end": 12.76,
      "text": "追加登録の締め切りはどこに印刷されていますか。",
      "avgLogprob": -0.17264408410572615,
      "noSpeechProb": 0.03501708060503006
    },
    {
      "start": 13.66,
      "end": 14.98,
      "text": "申し込み書の裏です。",
