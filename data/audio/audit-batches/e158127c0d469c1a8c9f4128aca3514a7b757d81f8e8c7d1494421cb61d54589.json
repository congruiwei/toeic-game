  "segments": [
    {
      "start": 0.0,
      "end": 3.62,
      "text": "打点時は角入り口に長いマットを敷きます。",
      "avgLogprob": -0.2574641742706299,
      "noSpeechProb": 0.06543782353401184
    },
    {
      "start": 3.96,
      "end": 7.68,
      "text": "閉館前にマットを1枚ずつ床から持ち上げてください。",
      "avgLogprob": -0.2574641742706299,
      "noSpeechProb": 0.06543782353401184
    },
    {
      "start": 8.66,
      "end": 11.7,
      "text": "両面が革くよう洗い場の場合にかけてください。",
      "avgLogprob": -0.2574641742706299,
      "noSpeechProb": 0.06543782353401184
    },
    {
      "start": 12.6,
      "end": 15.9,
      "text": "カフェのそばのマットは他のものより重くなっています。",
      "avgLogprob": -0.2574641742706299,
      "noSpeechProb": 0.06543782353401184
    },
    {
      "start": 16.88,
      "end": 19.04,
      "text": "1枚ずつ2人で持ち上げてください。",
      "avgLogprob": -0.2574641742706299,
      "noSpeechProb": 0.06543782353401184
    },
    {
      "start": 19.94,
      "end": 22.06,
      "text": "カフェから洗い場までは距離があります。",
      "avgLogprob": -0.2574641742706299,
      "noSpeechProb": 0.06543782353401184
    }
  ]
