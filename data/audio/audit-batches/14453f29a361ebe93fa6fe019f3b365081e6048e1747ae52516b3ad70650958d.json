  "segments": [
    {
      "start": 0.0,
      "end": 3.2,
      "text": "当て並べるを見るとお隣当ての荷物です。",
      "avgLogprob": -0.19388872680479083,
      "noSpeechProb": 0.05453508347272873
    },
    {
      "start": 3.9,
      "end": 9.52,
      "text": "今日の証後に運転手が回収に来るのでそれまでは入り口を開けておいてください。",
      "avgLogprob": -0.19388872680479083,
      "noSpeechProb": 0.05453508347272873
    },
    {
      "start": 10.42,
      "end": 13.42,
      "text": "ジョー。そのお茶ははかり売りしています。",
      "avgLogprob": -0.19388872680479083,
      "noSpeechProb": 0.05453508347272873
    },
    {
      "start": 14.44,
      "end": 16.56,
      "text": "中身は冷やしておく必要があります。",
      "avgLogprob": -0.19388872680479083,
      "noSpeechProb": 0.05453508347272873
    },
    {
      "start": 17.5,
      "end": 19.6,
      "text": "棚にはそれを置くスペースがあります。",
