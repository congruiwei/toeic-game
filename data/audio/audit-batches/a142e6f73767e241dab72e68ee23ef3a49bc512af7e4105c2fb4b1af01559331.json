  "segments": [
    {
      "start": 0.0,
      "end": 3.28,
      "text": "消さ届いたのはナフダ用のワッペンだけです。",
      "avgLogprob": -0.1389243696449381,
      "noSpeechProb": 0.06277380138635635
    },
    {
      "start": 4.0,
      "end": 6.82,
      "text": "用紙が確認済みかどうかどう見分けますか。",
      "avgLogprob": -0.1389243696449381,
      "noSpeechProb": 0.06277380138635635
    },
    {
      "start": 7.68,
      "end": 9.54,
      "text": "用紙は受付で入手できます。",
      "avgLogprob": -0.1389243696449381,
      "noSpeechProb": 0.06277380138635635
    },
    {
      "start": 10.52,
      "end": 14.36,
      "text": "編集者のイニシャルの横に日付があるか確認してください。",
      "avgLogprob": -0.1389243696449381,
      "noSpeechProb": 0.06277380138635635
    },
    {
      "start": 15.34,
      "end": 18.84,
      "text": "その編集者は月曜日に審査員に加わりました。",
      "avgLogprob": -0.1389243696449381,
      "noSpeechProb": 0.06277380138635635
    },
    {
      "start": 19.74,
      "end": 23.16,
      "text": "ツアーはパン屋から始めますかそれともそこで終えますか。",
      "avgLogprob": -0.1389243696449381,
      "noSpeechProb": 0.06277380138635635
    }
  ]
