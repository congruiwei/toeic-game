    {
      "start": 5.32,
      "end": 10.72,
      "text": "最初に何を測るべきですか。その日で最も重い小包み。",
      "avgLogprob": -0.27743825346839673,
      "noSpeechProb": 0.22634434700012207
    },
    {
      "start": 10.86,
      "end": 15.7,
      "text": "曰日の代表。避遵噴動。空の輸送箱。",
      "avgLogprob": -0.27743825346839673,
      "noSpeechProb": 0.22634434700012207
    },
    {
      "start": 16.54,
      "end": 20.4,
      "text": "最初に古白色が点灯したら担当者はどうすべきですか。",
