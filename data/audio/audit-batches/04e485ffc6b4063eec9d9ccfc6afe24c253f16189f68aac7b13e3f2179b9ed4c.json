    },
    {
      "start": 6.0,
      "end": 11.52,
      "text": "短いに缶を両方交換する。短い生地をもう1缶買う。",
      "avgLogprob": -0.22661085526148478,
      "noSpeechProb": 0.02037958800792694
    },
    {
      "start": 11.68,
      "end": 13.34,
      "text": "人名トルの巻を残す。",
