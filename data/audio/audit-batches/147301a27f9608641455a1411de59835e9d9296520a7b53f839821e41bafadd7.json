    {
      "start": 5.28,
      "end": 9.98,
      "text": "早晩のチームが商品行動を読むには全ての証明が必要です。",
      "avgLogprob": -0.13906951921176067,
      "noSpeechProb": 0.01585812121629715
    },
    {
      "start": 10.78,
      "end": 13.98,
      "text": "試験中になぜ天井証明を消しておくのですか。",
      "avgLogprob": -0.13906951921176067,
      "noSpeechProb": 0.01585812121629715
    },
    {
      "start": 14.88,
      "end": 18.16,
