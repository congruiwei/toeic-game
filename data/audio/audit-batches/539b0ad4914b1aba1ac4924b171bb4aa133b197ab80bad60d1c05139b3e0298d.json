    {
      "start": 5.2,
      "end": 8.96,
      "text": "読み取りが繰り返される度にチケットを印刷したからです。",
      "avgLogprob": -0.14509812860112442,
      "noSpeechProb": 0.050733089447021484
    },
    {
      "start": 9.74,
      "end": 13.36,
      "text": "博物館の夜間イベントが始まる前にしまったからです。",
      "avgLogprob": -0.14509812860112442,
      "noSpeechProb": 0.050733089447021484
    },
    {
      "start": 14.24,
      "end": 16.46,
      "text": "最後の文は何を指さしていますか。",
