  "segments": [
    {
      "start": 0.0,
      "end": 5.88,
      "text": "取扱い注意の木箱は無事に届いた壊れたのは開封用の挟みだった。",
      "avgLogprob": -0.15993093010178186,
      "noSpeechProb": 0.014545006677508354
    },
    {
      "start": 6.5,
      "end": 11.18,
      "text": "腰回収のお知らせを印刷するために紙を一パレット発注した。",
      "avgLogprob": -0.15993093010178186,
      "noSpeechProb": 0.014545006677508354
    },
    {
      "start": 12.06,
      "end": 16.84,
      "text": "新しいコピー機は誰かが電源を見つける前にフォークリフトで引っ越した。",
      "avgLogprob": -0.15993093010178186,
      "noSpeechProb": 0.014545006677508354
    },
    {
      "start": 17.7,
      "end": 22.94,
      "text": "行方不明のサンドイッチが空腹の作業員全員の前をコンベヤーで二周した。",
      "avgLogprob": -0.15993093010178186,
      "noSpeechProb": 0.014545006677508354
    }
