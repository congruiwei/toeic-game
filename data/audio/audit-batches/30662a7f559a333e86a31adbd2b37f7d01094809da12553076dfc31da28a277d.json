    },
    {
      "start": 7.18,
      "end": 12.9,
      "text": "会社が両方の建物を所有していれば倉庫を道路の向かい側に移せるでしょう。",
      "avgLogprob": -0.12400801867997947,
      "noSpeechProb": 0.009672326035797596
    },
    {
      "start": 13.8,
      "end": 16.22,
      "text": "現在は両方とも借りているだけです。",
      "avgLogprob": -0.12400801867997947,
      "noSpeechProb": 0.009672326035797596
    },
    {
      "start": 17.02,
      "end": 21.56,
