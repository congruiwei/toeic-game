  "segments": [
    {
      "start": 0.36000000000000054,
      "end": 5.48,
      "text": "水道のジャグ地は修理担当者が後ろを向くたびにきっちり行ってきだけたれる。",
      "avgLogprob": -0.1820897242819616,
      "noSpeechProb": 0.0466766394674778
    },
    {
      "start": 6.18,
      "end": 11.36,
      "text": "配管は完璧に機能する配管宅民さんが受付に立っている間だけは、",
      "avgLogprob": -0.1820897242819616,
      "noSpeechProb": 0.0466766394674778
    },
    {
      "start": 12.1,
      "end": 16.46,
      "text": "古い配線のおかげで水地一つが三部署の明かりを握っている。",
      "avgLogprob": -0.1820897242819616,
      "noSpeechProb": 0.0466766394674778
    },
    {
      "start": 17.28,
      "end": 23.1,
      "text": "地下室にあるのは非常用品と車内で誰にも透かれなかった椅子の全員集合だ。",
      "avgLogprob": -0.1820897242819616,
      "noSpeechProb": 0.0466766394674778
    }
