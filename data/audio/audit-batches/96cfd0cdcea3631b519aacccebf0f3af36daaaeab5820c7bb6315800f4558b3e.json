    {
      "start": 4.9,
      "end": 8.16,
      "text": "まず当店のウェブサイトで日事を選びください。",
      "avgLogprob": -0.1444883555883453,
      "noSpeechProb": 0.040609825402498245
    },
    {
      "start": 9.04,
      "end": 12.0,
      "text": "次に修理が必要な箇所をお知らせください。",
      "avgLogprob": -0.1444883555883453,
      "noSpeechProb": 0.040609825402498245
    },
    {
      "start": 12.86,
      "end": 17.58,
      "text": "不具合用語説明いただく際はできるだけ、正確にお伝えください。",
      "avgLogprob": -0.1444883555883453,
      "noSpeechProb": 0.040609825402498245
    },
    {
      "start": 18.48,
      "end": 22.7,
      "text": "詳しくご説明いただくと整備士があらかじめ工具を準備できます。",
