    {
      "start": 0.0,
      "end": 6.58,
      "text": "周辞のキャッシュフローズは、現金が実際に事業へ入る時点と出ていく時点を示します。",
      "avgLogprob": -0.20380020062580254,
      "noSpeechProb": 0.025710001587867737
    },
    {
      "start": 7.4,
      "end": 7.96,
      "text": "固定費",
      "avgLogprob": -0.20380020062580254,
      "noSpeechProb": 0.025710001587867737
    },
    {
      "start": 8.600000000000001,
      "end": 14.96,
      "text": "家賃は固定費でスタジオが注文を一見処理しても、戦権処理しても金額は変わりません。",
      "avgLogprob": -0.20380020062580254,
      "noSpeechProb": 0.025710001587867737
    },
    {
      "start": 15.88,
      "end": 16.54,
      "text": "変動費",
      "avgLogprob": -0.20380020062580254,
      "noSpeechProb": 0.025710001587867737
    },
    {
      "start": 17.18,
      "end": 22.44,
      "text": "インクは印刷部数が増えるほど費用が増す、ため、三つもりでは変動費です。",
      "avgLogprob": -0.20380020062580254,
      "noSpeechProb": 0.025710001587867737
    }
