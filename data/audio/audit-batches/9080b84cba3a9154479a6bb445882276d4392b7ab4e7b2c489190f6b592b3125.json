  "segments": [
    {
      "start": 0.0,
      "end": 4.76,
      "text": " A striped awning. A painted fence. A row of ticket machines.",
      "avgLogprob": -0.09768635957013994,
      "noSpeechProb": 0.03399452194571495
    },
    {
      "start": 5.58,
      "end": 7.82,
      "text": " Will the assembled desk fit through the studio door?",
      "avgLogprob": -0.09768635957013994,
      "noSpeechProb": 0.03399452194571495
    },
    {
      "start": 8.64,
      "end": 12.0,
      "text": " I measured it this morning. The door is too narrow.",
      "avgLogprob": -0.09768635957013994,
      "noSpeechProb": 0.03399452194571495
    },
    {
      "start": 12.84,
      "end": 15.5,
      "text": " Can the delivery team bring the top and legs in separately?",
      "avgLogprob": -0.09768635957013994,
      "noSpeechProb": 0.03399452194571495
    },
    {
      "start": 16.56,
      "end": 19.7,
      "text": " Yes, but they'll need a clear space inside to put it together.",
