  "segments": [
    {
      "start": 0.0,
      "end": 5.62,
      "text": "入殺所が厳重に封印され、過ぎて開封が別の長達事業になりました。",
      "avgLogprob": -0.13659085273742677,
      "noSpeechProb": 0.016912980005145073
    },
    {
      "start": 6.34,
      "end": 11.7,
      "text": "意見募集の別の方法を提案しないという条件で社員から意見を募ります。",
      "avgLogprob": -0.13659085273742677,
      "noSpeechProb": 0.016912980005145073
    },
    {
      "start": 12.66,
      "end": 17.34,
      "text": "契約そのものより、交渉の日程を調整する方に時間がかかりました。",
      "avgLogprob": -0.13659085273742677,
      "noSpeechProb": 0.016912980005145073
    },
    {
      "start": 18.26,
      "end": 22.5,
      "text": "決済サイトが落ち着いてくれれば、教授に請求額を支払えます。",
      "avgLogprob": -0.13659085273742677,
      "noSpeechProb": 0.016912980005145073
    }
