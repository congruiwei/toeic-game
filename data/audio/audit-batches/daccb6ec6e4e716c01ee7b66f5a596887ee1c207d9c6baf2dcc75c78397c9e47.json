  "segments": [
    {
      "start": 0.0,
      "end": 3.22,
      "text": " This folding bench won't lie flat when we put it away.",
      "avgLogprob": -0.09788531994306914,
      "noSpeechProb": 0.02772681973874569
    },
    {
      "start": 4.04,
      "end": 5.8,
      "text": " Is there anything caught between the hinges?",
      "avgLogprob": -0.09788531994306914,
      "noSpeechProb": 0.02772681973874569
    },
    {
      "start": 6.72,
      "end": 9.66,
      "text": " I checked them, and there's a loose strap underneath the seat.",
      "avgLogprob": -0.09788531994306914,
      "noSpeechProb": 0.02772681973874569
    },
    {
      "start": 10.38,
      "end": 13.4,
      "text": " That strap holds the legs together once the bench is folded.",
      "avgLogprob": -0.09788531994306914,
      "noSpeechProb": 0.02772681973874569
    },
    {
      "start": 14.36,
      "end": 16.64,
      "text": " Then tuck it aside before you close the seat.",
      "avgLogprob": -0.09788531994306914,
      "noSpeechProb": 0.02772681973874569
    },
    {
      "start": 17.28,
      "end": 20.18,
      "text": " That worked. I'll show the evening crew how to store it.",
      "avgLogprob": -0.09788531994306914,
      "noSpeechProb": 0.02772681973874569
    },
    {
      "start": 20.94,
      "end": 22.52,
