  "segments": [
    {
      "start": 0.0,
      "end": 4.08,
      "text": " Rarely does the lift stop between floors. It is normally reliable.",
      "avgLogprob": -0.12217678758035223,
      "noSpeechProb": 0.017830632627010345
    },
    {
      "start": 4.74,
      "end": 7.66,
      "text": " Only after the doors opened did the queue begin to move.",
      "avgLogprob": -0.12217678758035223,
      "noSpeechProb": 0.017830632627010345
    },
    {
      "start": 8.6,
      "end": 13.08,
      "text": " At no time were visitors permitted to handle the samples during yesterday's tour.",
      "avgLogprob": -0.12217678758035223,
      "noSpeechProb": 0.017830632627010345
    },
    {
      "start": 13.96,
      "end": 18.54,
      "text": " Not only did the courier collect the parcel, but she also brought new labels yesterday.",
      "avgLogprob": -0.12217678758035223,
      "noSpeechProb": 0.017830632627010345
    },
    {
      "start": 19.46,
      "end": 22.72,
      "text": " No sooner had we posted the notice than the first inquiry arrived.",
      "avgLogprob": -0.12217678758035223,
