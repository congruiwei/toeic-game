      "avgLogprob": -0.19252337903535666,
      "noSpeechProb": 0.020775193348526955
    },
    {
      "start": 9.7,
      "end": 12.44,
      "text": "図面は大きな用紙に印刷されています。",
      "avgLogprob": -0.19252337903535666,
