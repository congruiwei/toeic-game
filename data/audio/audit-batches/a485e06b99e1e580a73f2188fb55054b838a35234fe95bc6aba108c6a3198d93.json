      "noSpeechProb": 0.010410732589662075
    },
    {
      "start": 5.96,
      "end": 12.12,
      "text": " That means a rise in new trials could depress our reported rate even if decisions at expiry stayed the same.",
      "avgLogprob": -0.11541437538894447,
      "noSpeechProb": 0.010410732589662075
    },
    {
      "start": 13.04,
      "end": 15.96,
      "text": " Can you rebuild the calculation by expiry date?",
