  "segments": [
    {
      "start": 0.0,
      "end": 6.04,
      "text": "前回の文は即達で届きました。まずもっと幅の広い板が必要です。",
      "avgLogprob": -0.14379534695459448,
      "noSpeechProb": 0.028765149414539337
    },
    {
      "start": 6.84,
      "end": 9.68,
      "text": "ゲスト出演者はいつ部隊に上がればよいですか。",
      "avgLogprob": -0.14379534695459448,
      "noSpeechProb": 0.028765149414539337
    },
    {
      "start": 10.48,
      "end": 14.84,
      "text": "ゲスト出演者は中央駅の横の新しいホテルに止まっています。",
      "avgLogprob": -0.14379534695459448,
      "noSpeechProb": 0.028765149414539337
    },
    {
      "start": 15.82,
      "end": 19.16,
      "text": "幕の横の青いライトが点灯するまで待ってください。",
      "avgLogprob": -0.14379534695459448,
      "noSpeechProb": 0.028765149414539337
    },
    {
      "start": 20.0,
      "end": 22.2,
      "text": "部隊は多くの板で作られています。",
      "avgLogprob": -0.14379534695459448,
      "noSpeechProb": 0.028765149414539337
    }
  ]
