  "segments": [
    {
      "start": 0.0,
      "end": 5.62,
      "text": "市内銃の地図を預かる配送拠点で、うちの地図だけが行方不明になった。",
      "avgLogprob": -0.18633876373802405,
      "noSpeechProb": 0.0246693454682827
    },
    {
      "start": 6.32,
      "end": 11.28,
      "text": "トラックが二砂崎上に着いた時関芸の大弾幕はまだ書きかけだった。",
      "avgLogprob": -0.18633876373802405,
      "noSpeechProb": 0.0246693454682827
    },
    {
      "start": 12.08,
      "end": 17.36,
      "text": "最後の秋バースに船を入れたら、隣は船長が手放したばかりの船だった。",
      "avgLogprob": -0.18633876373802405,
      "noSpeechProb": 0.0246693454682827
    },
    {
      "start": 18.24,
      "end": 22.32,
      "text": "職場用の傘を積んだ船が着いたのは、梅雨が開けた直後だった。",
      "avgLogprob": -0.18633876373802405,
      "noSpeechProb": 0.0246693454682827
    }
  ]
