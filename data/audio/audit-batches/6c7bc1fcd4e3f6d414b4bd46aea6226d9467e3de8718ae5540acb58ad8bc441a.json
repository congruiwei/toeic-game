  "segments": [
    {
      "start": 0.36000000000000054,
      "end": 5.06,
      "text": "正面カウンターは、塗装中のために我側の扉からを入りください。",
      "avgLogprob": -0.23249386957962148,
      "noSpeechProb": 0.03259112685918808
    },
    {
      "start": 5.92,
      "end": 9.7,
      "text": "ご注文字にお渡した黄色い引き換え剣王を持ちください。",
      "avgLogprob": -0.23249386957962148,
      "noSpeechProb": 0.03259112685918808
    },
    {
      "start": 10.64,
      "end": 11.68,
      "text": "マワレインプレント。",
      "avgLogprob": -0.23249386957962148,
      "noSpeechProb": 0.03259112685918808
    },
    {
      "start": 12.48,
      "end": 15.76,
      "text": "絵画に我側の扉を使うべきなのはなぜですか。",
      "avgLogprob": -0.23249386957962148,
      "noSpeechProb": 0.03259112685918808
    },
    {
      "start": 16.62,
      "end": 20.14,
      "text": "ポスターの幅が広すぎて正面玄関を通らないから、",
      "avgLogprob": -0.23249386957962148,
      "noSpeechProb": 0.03259112685918808
    },
    {
      "start": 20.96,
      "end": 23.12,
      "text": "横のカウンターが二次に閉まるから。",
      "avgLogprob": -0.23249386957962148,
      "noSpeechProb": 0.03259112685918808
    }
  ]
