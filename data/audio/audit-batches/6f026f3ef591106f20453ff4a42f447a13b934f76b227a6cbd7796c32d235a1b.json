  "segments": [
    {
      "start": 0.3799999999999999,
      "end": 1.88,
      "text": "従業員用の基賃",
      "avgLogprob": -0.16123706662756765,
      "noSpeechProb": 0.08705084770917892
    },
    {
      "start": 2.6999999999999993,
      "end": 7.1,
      "text": "新しいブラインド用にオフィスの窓を再寸してもらいたいのですが",
      "avgLogprob": -0.16123706662756765,
      "noSpeechProb": 0.08705084770917892
    },
    {
      "start": 7.659999999999999,
      "end": 12.08,
      "text": "志向担当は火用日の午前か木用日の午後に伺えます",
      "avgLogprob": -0.16123706662756765,
      "noSpeechProb": 0.08705084770917892
    },
    {
      "start": 12.68,
      "end": 16.8,
      "text": "火用日の午前中はずっと会議なので木用日が良いです",
      "avgLogprob": -0.16123706662756765,
      "noSpeechProb": 0.08705084770917892
    },
    {
      "start": 17.52,
      "end": 22.38,
      "text": "その日時で予約し担当者の名前をショートメッセージでお送りします",
      "avgLogprob": -0.16123706662756765,
      "noSpeechProb": 0.08705084770917892
    }
