      "end": 8.5,
      "text": " The bottom was coming open.",
      "avgLogprob": -0.0925343482196331,
      "noSpeechProb": 0.032425832003355026
    },
    {
      "start": 9.2,
      "end": 10.84,
      "text": " Why don't we read the leaflet on the bus?",
      "avgLogprob": -0.0925343482196331,
      "noSpeechProb": 0.032425832003355026
    },
    {
      "start": 11.62,
      "end": 13.7,
      "text": " The leaflet folds into three panels.",
      "avgLogprob": -0.0925343482196331,
      "noSpeechProb": 0.032425832003355026
    },
    {
      "start": 14.54,
      "end": 16.1,
      "text": " I get dizzy reading on the road.",
      "avgLogprob": -0.0925343482196331,
      "noSpeechProb": 0.032425832003355026
    },
    {
      "start": 16.98,
      "end": 18.14,
      "text": " The bus route is on the front.",
