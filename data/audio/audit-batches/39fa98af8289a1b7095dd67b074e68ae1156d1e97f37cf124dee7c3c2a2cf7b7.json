    },
    {
      "start": 2.4200000000000013,
      "end": 4.72,
      "text": "赤い柄のブラシは床用です",
      "avgLogprob": -0.1489326000213623,
      "noSpeechProb": 0.009820775128901005
    },
    {
      "start": 5.1800000000000015,
      "end": 7.58,
      "text": "無塗装の木製柄のブラシは",
      "avgLogprob": -0.1489326000213623,
      "noSpeechProb": 0.009820775128901005
    },
    {
      "start": 7.58,
      "end": 11.98,
      "text": "塗料管を開ける前に作業台のほこりを払うためのものです",
      "avgLogprob": -0.1489326000213623,
      "noSpeechProb": 0.009820775128901005
    },
    {
      "start": 12.580000000000002,
      "end": 15.46,
      "text": "流しの上に青い服を浸接しました",
      "avgLogprob": -0.1489326000213623,
      "noSpeechProb": 0.009820775128901005
    },
    {
      "start": 16.14,
      "end": 18.78,
      "text": "作業台用ブラシを使った後は",
      "avgLogprob": -0.1489326000213623,
      "noSpeechProb": 0.009820775128901005
    },
    {
      "start": 18.78,
      "end": 22.8,
      "text": "そこにかけ毛先が大に触れない状態で乾かしてください",
