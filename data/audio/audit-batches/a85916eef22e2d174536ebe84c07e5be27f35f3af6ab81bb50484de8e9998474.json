    {
      "start": 6.08,
      "end": 8.44,
      "text": "受け取る。片付ける。",
      "avgLogprob": -0.12438131606689205,
      "noSpeechProb": 0.11776723712682724
    },
    {
      "start": 9.28,
      "end": 15.3,
      "text": "大金を支払う。ポスターの注文について記載されていないのはどの情報ですか。",
