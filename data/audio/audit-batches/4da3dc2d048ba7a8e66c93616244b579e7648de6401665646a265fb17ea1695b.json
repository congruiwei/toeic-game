  "segments": [
    {
      "start": 0.4000000000000006,
      "end": 3.74,
      "text": "散策が終わる頃にちょうど焼きたてのパンが出ます。",
      "avgLogprob": -0.07828696800844513,
      "noSpeechProb": 0.034164465963840485
    },
    {
      "start": 4.3,
      "end": 7.52,
      "text": "パン屋の看板は地元のアーティストが描きました。",
      "avgLogprob": -0.07828696800844513,
      "noSpeechProb": 0.034164465963840485
    },
    {
      "start": 8.32,
      "end": 12.08,
      "text": "散策には歴史的建造物3箇所が含まれます。",
      "avgLogprob": -0.07828696800844513,
      "noSpeechProb": 0.034164465963840485
    },
    {
      "start": 12.92,
      "end": 16.4,
      "text": "動画ファイル全体を全員にメールで送ってはどうですか。",
      "avgLogprob": -0.07828696800844513,
      "noSpeechProb": 0.034164465963840485
    },
    {
      "start": 17.34,
      "end": 20.06,
      "text": "映像には短いインタビューが含まれます。",
      "avgLogprob": -0.07828696800844513,
      "noSpeechProb": 0.034164465963840485
    },
    {
      "start": 20.84,
      "end": 22.58,
      "text": "アドレスはアルファベット順です。",
      "avgLogprob": -0.07828696800844513,
      "noSpeechProb": 0.034164465963840485
    }
  ]
