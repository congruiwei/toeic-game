  "segments": [
    {
      "start": 0.0,
      "end": 4.06,
      "text": " The long bench near the newspaper stand will move to the window on Friday.",
      "avgLogprob": -0.09196250607450325,
      "noSpeechProb": 0.01364745944738388
    },
    {
      "start": 5.06,
      "end": 9.72,
      "text": " At its present location, the bench blocks a cupboard whenever someone sits at the left end.",
      "avgLogprob": -0.09196250607450325,
      "noSpeechProb": 0.01364745944738388
    },
    {
      "start": 10.7,
      "end": 14.12,
      "text": " Staff need to open that cupboard for a second delivery each afternoon.",
      "avgLogprob": -0.09196250607450325,
      "noSpeechProb": 0.01364745944738388
    },
    {
      "start": 15.34,
      "end": 19.2,
      "text": " An outlet by the new spot will also let visitors charge a phone while reading.",
      "avgLogprob": -0.09196250607450325,
      "noSpeechProb": 0.01364745944738388
    },
    {
      "start": 20.34,
      "end": 22.62,
      "text": " The newspaper stand itself will stay where it is.",
      "avgLogprob": -0.09196250607450325,
      "noSpeechProb": 0.01364745944738388
    }
  ]
