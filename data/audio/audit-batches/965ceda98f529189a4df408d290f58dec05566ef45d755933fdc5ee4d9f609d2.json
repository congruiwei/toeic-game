  "segments": [
    {
      "start": 0.0,
      "end": 5.16,
      "text": "電源が切られたから、展示中の春のメニュー。",
      "avgLogprob": -0.18716246064971476,
      "noSpeechProb": 0.039688628166913986
    },
    {
      "start": 5.24,
      "end": 12.14,
      "text": "ガラスの向こうのメニューは、ホテル初の春の晩産会用に印刷されたものを現代に復生したものです。",
      "avgLogprob": -0.18716246064971476,
      "noSpeechProb": 0.039688628166913986
    },
    {
      "start": 13.0,
      "end": 17.14,
      "text": "原本は痛みやすく展示室の照明の下に置き続けられません。",
      "avgLogprob": -0.18716246064971476,
      "noSpeechProb": 0.039688628166913986
    },
    {
      "start": 18.08,
      "end": 20.92,
      "text": "減寸で撮影しに大路の紙に印刷しました。",
      "avgLogprob": -0.18716246064971476,
