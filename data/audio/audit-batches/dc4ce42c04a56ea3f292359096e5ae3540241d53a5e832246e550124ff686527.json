  "segments": [
    {
      "start": 0.0,
      "end": 5.32,
      "text": "二送り人が返品用紙をあまりに 厳重に包んだせいで取り出せなかった。",
      "avgLogprob": -0.27065579682143764,
      "noSpeechProb": 0.03072165511548519
    },
    {
      "start": 6.14,
      "end": 12.02,
      "text": "配達の遅さについての苦情をその運送会社に託したら 一週間遅れで届いた。",
      "avgLogprob": -0.27065579682143764,
      "noSpeechProb": 0.03072165511548519
    },
    {
      "start": 12.86,
      "end": 17.18,
      "text": "二主は予備の鍵を送ってくれたその鍵で開ける箱の中にだ。",
      "avgLogprob": -0.27065579682143764,
      "noSpeechProb": 0.03072165511548519
    },
    {
      "start": 18.0,
      "end": 22.62,
      "text": "フォアーダーの手配は完璧だった 行組なとをこちらに伝えること以外は。",
      "avgLogprob": -0.27065579682143764,
      "noSpeechProb": 0.03072165511548519
    }
