      "noSpeechProb": 0.015727665275335312
    },
    {
      "start": 8.14,
      "end": 11.22,
      "text": "角箱の中に入っているお茶の一覧があります。",
      "avgLogprob": -0.1340847328060963,
      "noSpeechProb": 0.015727665275335312
    },
    {
      "start": 12.2,
      "end": 15.46,
      "text": "一覧の名前と棚のラベルを集合してください。",
