  "segments": [
    {
      "start": 0.0,
      "end": 3.88,
      "text": " If the depot had more space, it would keep the spare chairs on site.",
      "avgLogprob": -0.07088153017194647,
      "noSpeechProb": 0.020296737551689148
    },
    {
      "start": 4.76,
      "end": 8.3,
      "text": " If I were the person in charge, I would leave the counter open longer.",
      "avgLogprob": -0.07088153017194647,
      "noSpeechProb": 0.020296737551689148
    },
    {
      "start": 9.18,
      "end": 10.44,
      "text": " The office has no lift.",
      "avgLogprob": -0.07088153017194647,
      "noSpeechProb": 0.020296737551689148
    },
    {
      "start": 11.3,
      "end": 14.58,
      "text": " If it had one, visitors would reach the top floor more easily.",
      "avgLogprob": -0.07088153017194647,
      "noSpeechProb": 0.020296737551689148
    },
    {
      "start": 15.4,
      "end": 19.14,
      "text": " If the night bus ran later, fewer employees would take taxis home.",
