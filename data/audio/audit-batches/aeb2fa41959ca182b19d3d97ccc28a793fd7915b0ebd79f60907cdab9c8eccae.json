  "segments": [
    {
      "start": 0.0,
      "end": 5.5,
      "text": "8時15分保守チームは暗さを再現するため、光センサーを追いました。",
      "avgLogprob": -0.12343552483230077,
      "noSpeechProb": 0.020148934796452522
    },
    {
      "start": 6.200000000000001,
      "end": 8.82,
      "text": "5秒後に標識等が点灯しました。",
      "avgLogprob": -0.12343552483230077,
      "noSpeechProb": 0.020148934796452522
    },
    {
      "start": 9.580000000000002,
      "end": 14.16,
      "text": "8時20分センサーの追いを外すと標識等はすぐに消えました。",
      "avgLogprob": -0.12343552483230077,
      "noSpeechProb": 0.020148934796452522
    },
    {
      "start": 15.0,
      "end": 19.04,
      "text": "大雨の中で測定したいため夕方のテストは延期されました。",
      "avgLogprob": -0.12343552483230077,
      "noSpeechProb": 0.020148934796452522
    },
    {
      "start": 19.9,
      "end": 22.92,
      "text": "今日は雨の予報がないため別の日を選びます。",
      "avgLogprob": -0.12343552483230077,
