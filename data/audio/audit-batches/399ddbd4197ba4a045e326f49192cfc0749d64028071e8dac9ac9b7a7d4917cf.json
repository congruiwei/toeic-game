  "segments": [
    {
      "start": 0.0,
      "end": 6.24,
      "text": "鉛筆一本ずつを宝石のように包むのをやめたら、一本あたりの玄華が下がった。",
      "avgLogprob": -0.21238825346926132,
      "noSpeechProb": 0.03569082170724869
    },
    {
      "start": 6.96,
      "end": 11.68,
      "text": "メーカーは声音時計を試すためまず、その場の全員を黙らせた。",
      "avgLogprob": -0.21238825346926132,
      "noSpeechProb": 0.03569082170724869
    },
    {
      "start": 12.44,
      "end": 16.9,
      "text": "車内のデザインチームが見事なデザイナー募集の看板を作った。",
      "avgLogprob": -0.21238825346926132,
      "noSpeechProb": 0.03569082170724869
    },
    {
      "start": 17.72,
      "end": 22.92,
      "text": "企画会議を一回開くと遠足の子ども、立ち寄りも早くクッキーがそこをつく。",
      "avgLogprob": -0.21238825346926132,
      "noSpeechProb": 0.03569082170724869
